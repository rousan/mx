{
  "name": "mx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Source and control panel for mx — the multiplexer runtime tool",
  "packageManager": "pnpm@8.10.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter mx-multiplexer run build",
    "dev": "pnpm --filter mx-multiplexer run dev",
    "mx": "node apps/cli/dist/bin/mx.js",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^50.4.0",
    "prettier": "^3.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.0"
  }
}
