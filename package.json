{
  "name": "mx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multiplex work using claude codes - work in multiple features in parallel",
  "packageManager": "pnpm@8.10.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @mx/mission-control run build && pnpm --filter @mx/cli run build",
    "build:cli": "pnpm --filter @mx/cli run build",
    "dev": "pnpm --filter @mx/cli run dev",
    "mx": "node npm/bin/mx.js",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^50.4.0",
    "prettier": "^3.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.0"
  }
}