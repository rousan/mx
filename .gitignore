# local dev runtime (set MX_RUNTIME=$PWD/.mx to use it)
.mx/

# build output
dist/
*.tsbuildinfo

# publishable package built by `pnpm build` (npm/package.json and npm/README.md are committed)
npm/bin/
npm/templates/
npm/mission-control/
npm/LICENSE

# dependencies
node_modules/

# VitePress build output + cache — internal reference site (docs/) and the
# public user-docs site (apps/docs/).
docs/.vitepress/dist/
docs/.vitepress/cache/
apps/docs/.vitepress/dist/
apps/docs/.vitepress/cache/

# Menubar app (apps/menubar, Tauri) build output.
apps/menubar/dist/
apps/menubar/src-tauri/target/
apps/menubar/src-tauri/gen/

# landing + docs site build output
apps/landing/dist/

# playwright screenshot/console artifacts
.playwright-mcp/

# macOS
.DS_Store
