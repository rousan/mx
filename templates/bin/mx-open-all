#!/usr/bin/env bash
#
# mx-open-all — open mx works in ONE fullscreen macOS Terminal window, one tab
# per work, each running `mx work attach <work>`.
#
#   mx-open-all                     # open every ACTIVE work
#   mx-open-all sidekick dev-mx     # only the named works (a subset)
#   mx-open-all 'valkyrie-*'        # works matching a glob (quote it!)
#   mx-open-all -x 'sk-*'           # every active work EXCEPT those matching a glob
#   mx-open-all -x 'sk-*' -x dojo   # repeat -x to exclude more
#
# Positional args select works to open — an exact name, or a shell glob like
# `valkyrie-*` (quote globs so your shell doesn't expand them first); with none,
# all active works. `-x`/`--except <glob>` removes matching works from that set
# (repeatable). Only ACTIVE works are ever opened; an exact name that isn't an
# active work is skipped with a warning.
#
# macOS + Terminal.app only. This is a shipped bin (mx re-stamps it on
# init/sync). It asks mx for the works (stable JSON via --porcelain), then drives
# Terminal.app with AppleScript: the first work opens a new window (tab 1), each
# remaining work gets a new tab (Cmd-T), and the window is finally made
# fullscreen. Each tab runs `mx work attach <work>`, building/attaching its tmux
# session.
set -euo pipefail

# Parse args: -x/--except <glob> excludes (repeatable); everything else is an
# include selector (an exact name or a glob).
includes=()
excludes=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help)
      sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    -x | --except)
      shift
      [ "$#" -gt 0 ] || { echo "mx-open-all: -x/--except needs a pattern" >&2; exit 2; }
      excludes+=("$1")
      ;;
    -*)
      echo "mx-open-all: unknown flag: $1" >&2
      exit 2
      ;;
    *)
      includes+=("$1")
      ;;
  esac
  shift
done

# Terminal.app + AppleScript is macOS-only. Fail cleanly elsewhere rather than
# erroring deep inside osascript.
if [ "$(uname -s)" != "Darwin" ]; then
  echo "mx-open-all: macOS + Terminal.app only" >&2
  exit 1
fi

# The runtime the tabs should target. Terminal opens fresh login shells that
# won't inherit this process's environment, so we bake it into each command.
runtime="${MX_RUNTIME:-$HOME/mx}"

# The set of ACTIVE work names. `mx work ls --porcelain` is active-only by
# default; the isArchived guard is belt-and-suspenders. node is always present
# (mx itself runs on it). Portable read loop (macOS's stock bash 3.2 — no mapfile).
active=()
while IFS= read -r line; do
  [ -n "$line" ] && active+=("$line")
done < <(MX_RUNTIME="$runtime" mx work ls --porcelain | node -e '
  let s = "";
  process.stdin.on("data", (d) => (s += d)).on("end", () => {
    for (const w of JSON.parse(s)) if (w.isArchived !== true) console.log(w.name);
  });
')

if [ "${#active[@]}" -eq 0 ]; then
  echo "mx-open-all: no active mx works to open" >&2
  exit 0
fi

# Build the candidate set from the include selectors (or all active if none). A
# selector is a glob when it contains * ? or [ ; otherwise an exact name that
# must be active (else warn). `[[ x == pat ]]` glob-matches with pat unquoted.
cand=()
if [ "${#includes[@]}" -eq 0 ]; then
  cand=("${active[@]}")
else
  for tok in "${includes[@]}"; do
    case "$tok" in
      *[\*\?\[]*)
        matched=0
        for a in "${active[@]}"; do
          if [[ "$a" == $tok ]]; then cand+=("$a"); matched=1; fi
        done
        [ "$matched" -eq 0 ] && echo "mx-open-all: no active work matches \"$tok\"" >&2
        ;;
      *)
        found=0
        for a in "${active[@]}"; do [ "$a" = "$tok" ] && found=1 && break; done
        if [ "$found" -eq 1 ]; then
          cand+=("$tok")
        else
          echo "mx-open-all: ignoring \"$tok\" (not an active work)" >&2
        fi
        ;;
    esac
  done
fi

# Apply excludes and de-duplicate (a work can match several selectors / globs).
works=()
if [ "${#cand[@]}" -gt 0 ]; then
  for w in "${cand[@]}"; do
    dup=0
    if [ "${#works[@]}" -gt 0 ]; then
      for x in "${works[@]}"; do [ "$x" = "$w" ] && dup=1 && break; done
    fi
    [ "$dup" -eq 1 ] && continue
    skip=0
    if [ "${#excludes[@]}" -gt 0 ]; then
      for pat in "${excludes[@]}"; do [[ "$w" == $pat ]] && skip=1 && break; done
    fi
    [ "$skip" -eq 1 ] && continue
    works+=("$w")
  done
fi

if [ "${#works[@]}" -eq 0 ]; then
  echo "mx-open-all: nothing to open" >&2
  exit 0
fi

# Escape a string for safe embedding inside an AppleScript double-quoted literal
# (backslash and double-quote).
apl() { printf '%s' "$1" | sed 's/[\\"]/\\&/g'; }

# The shell command a tab runs for a given work. `mx work attach` takes the work
# via `-n <name>` (not a positional), so build it that way.
attach_cmd() { printf 'MX_RUNTIME=%s mx work -n %s attach' "$(apl "$runtime")" "$(apl "$1")"; }

# Build the AppleScript. Tab 1 opens a new window; the rest are new tabs in it.
script="tell application \"Terminal\"
  activate
  do script \"$(attach_cmd "${works[0]}")\"
end tell
delay 0.6"

i=1
while [ "$i" -lt "${#works[@]}" ]; do
  script="$script
tell application \"System Events\" to keystroke \"t\" using command down
delay 0.6
tell application \"Terminal\" to do script \"$(attach_cmd "${works[$i]}")\" in front window
delay 0.3"
  i=$((i + 1))
done

# Finally, make the fleet window fullscreen.
script="$script
tell application \"System Events\" to tell process \"Terminal\"
  set value of attribute \"AXFullScreen\" of window 1 to true
end tell"

echo "mx-open-all: opening ${#works[@]} work(s) in a fullscreen Terminal..." >&2
osascript -e "$script"
