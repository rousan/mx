#!/usr/bin/env bash
#
# mx-tmux-resurrect-filter — keep mx-owned tmux sessions out of tmux-resurrect.
#
# mx sessions (named "mx/<work>") are derived state: `mx work attach` rebuilds a
# work's layout deterministically, so they never need to be restored from a
# saved snapshot — and restoring one would resurrect a session mx may have
# already archived. This script strips mx sessions from the most recent
# tmux-resurrect save so your OTHER sessions still resurrect normally.
#
# Wire it into tmux-resurrect by adding ONE line to ~/.tmux.conf (after the
# resurrect plugin is loaded):
#
#     set -g @resurrect-hook-post-save-all 'mx-tmux-resurrect-filter'
#
# (Requires <runtime>/bin on your PATH — `export PATH="$(mx bin path):$PATH"`.)
#
# It edits the resurrect "last" save file in place, dropping every pane/window/
# grouped_session record whose session name begins with "mx/". Safe to run when
# there is no save file yet (it just exits).
set -euo pipefail

# Resolve the resurrect directory: the @resurrect-dir option if set, else the
# plugin default. Expand a leading ~ ourselves since tmux stores it literally.
dir="$(tmux show-option -gqv @resurrect-dir 2>/dev/null || true)"
if [ -z "$dir" ]; then
  dir="${XDG_DATA_HOME:-$HOME/.tmux/resurrect}"
  # The classic default location is ~/.tmux/resurrect; prefer it when present.
  [ -d "$HOME/.tmux/resurrect" ] && dir="$HOME/.tmux/resurrect"
fi
case "$dir" in "~"*) dir="$HOME${dir#\~}" ;; esac

last="$dir/last"
[ -e "$last" ] || exit 0

# Resolve the symlink to the actual timestamped save file, then filter it.
target="$(readlink "$last" 2>/dev/null || true)"
[ -n "$target" ] || target="$last"
case "$target" in /*) : ;; *) target="$dir/$target" ;; esac
[ -f "$target" ] || exit 0

tmp="$(mktemp)"
# Drop pane/window/grouped_session lines whose session-name field (column 2)
# starts with "mx/"; keep everything else (state lines, other sessions) intact.
awk -F '\t' '
  ($1 == "pane" || $1 == "window" || $1 == "grouped_session") && $2 ~ /^mx\// { next }
  { print }
' "$target" > "$tmp"
mv "$tmp" "$target"
