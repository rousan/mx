#!/usr/bin/env bash
#
# mx-tmux-resurrect-filter — keep mx work sessions OUT of tmux-resurrect.
#
# mx work sessions (mx/<work>) are disposable: `mx work attach` rebuilds a work's
# layout on demand, so there's no reason for tmux-resurrect to persist them, and
# restoring a stale one after a reboot is just noise. This strips every mx/<work>
# session from the most recent resurrect save, so your OTHER sessions still
# save/restore normally.
#
# Wire it into tmux-resurrect with ONE line in ~/.tmux.conf, after the plugin is
# loaded:
#
#     set -g @resurrect-hook-post-save-all 'mx-tmux-resurrect-filter'
#
# (Requires <runtime>/bin on your PATH: export PATH="$(mx bin path):$PATH".)
#
# After a reboot your mx sessions simply won't come back — recreate them with
# `mx-open-all` or `mx work attach`. Safe to run when there is no save file yet,
# or when resurrect isn't installed (it just exits 0).
#
# This is a shipped bin (mx re-stamps it on init/sync).
set -euo pipefail

# Resolve the resurrect directory: the @resurrect-dir option if set, else the
# plugin default. Expand a leading ~ ourselves since tmux stores it literally.
dir="$(tmux show-option -gqv @resurrect-dir 2>/dev/null || true)"
if [ -z "$dir" ]; then
  dir="${XDG_DATA_HOME:-$HOME/.tmux/resurrect}"
  [ -d "$HOME/.tmux/resurrect" ] && dir="$HOME/.tmux/resurrect"
fi
case "$dir" in "~"*) dir="$HOME${dir#\~}" ;; esac

last="$dir/last"
[ -e "$last" ] || exit 0

# Resolve the symlink to the actual timestamped save file.
target="$(readlink "$last" 2>/dev/null || true)"
[ -n "$target" ] || target="$last"
case "$target" in /*) : ;; *) target="$dir/$target" ;; esac
[ -f "$target" ] || exit 0

tmp="$(mktemp)"
# Drop every record whose session field (column 2) starts with "mx/": pane,
# window, grouped_session, and state (the active-client pointer). Everything else
# — your other sessions — is kept verbatim.
awk -F '\t' '
  ($1 == "pane" || $1 == "window" || $1 == "grouped_session" || $1 == "state") && $2 ~ /^mx\// { next }
  { print }
' "$target" > "$tmp"
mv "$tmp" "$target"
